+	b43_phy_write(dev, 0x461, save->r461);
+	b43_phy_write(dev, 0x462, save->r462);
+	b43_phy_write(dev, 0x463, save->r463);
+	b43_phy_write(dev, 0x471, save->r471);
+	b43_phy_write(dev, 0x382, save->r382);
