From 8ec8bddc7ada201481449a1b1ba8375d405da1d9 Mon Sep 17 00:00:00 2001
From: Andreas Wendleder <gonsolo@gmail.com>
Date: Tue, 13 Oct 2026 23:55:31 +0200
Subject: [PATCH wireless-next 3/3] wifi: b43: retry RX buffer refills that
 failed under memory pressure

dma_rx() refills a slot with GFP_ATOMIC. When that fails it reposts the
old buffer, and nothing tries again: an idle slot and a slot stuck after
a failed refill both hold a poisoned buffer, so they cannot be told apart
by the poison alone.

Add a flag to the slot meta data that is set when a refill failed, and a
function that walks the RX ring and retries those slots. It runs from the
15 second periodic work, under wl->mutex like b43_dma_rx() itself, and
does nothing unless a refill has failed.
---
 drivers/net/wireless/broadcom/b43/dma.c  | 36 ++++++++++++++++++++++++
 drivers/net/wireless/broadcom/b43/dma.h  |  3 ++
 drivers/net/wireless/broadcom/b43/main.c |  2 ++
 3 files changed, 41 insertions(+)

diff --git a/drivers/net/wireless/broadcom/b43/dma.c b/drivers/net/wireless/broadcom/b43/dma.c
index 20d910a..10d5a4c 100644
--- a/drivers/net/wireless/broadcom/b43/dma.c
+++ b/drivers/net/wireless/broadcom/b43/dma.c
@@ -1675,8 +1675,10 @@ static void dma_rx(struct b43_dmaring *ring, int *slot)
 	err = setup_rx_descbuffer(ring, desc, meta, GFP_ATOMIC);
 	if (unlikely(err)) {
 		b43dbg(ring->dev->wl, "DMA RX: setup_rx_descbuffer() failed\n");
+		meta->rx_refill_failed = true;
 		goto drop_recycle_buffer;
 	}
+	meta->rx_refill_failed = false;
 
 	unmap_descbuffer(ring, dmaaddr, ring->rx_buffersize, 0);
 	skb_put(skb, len + ring->frameoffset);
@@ -1692,6 +1694,40 @@ drop_recycle_buffer:
 	sync_descbuffer_for_device(ring, dmaaddr, ring->rx_buffersize);
 }
 
+void b43_dma_rx_retry_poisoned(struct b43_wldev *dev)
+{
+	struct b43_dmaring *ring = dev->dma.rx_ring;
+	struct b43_dmadesc_generic *desc;
+	struct b43_dmadesc_meta *meta;
+	struct sk_buff *old_skb;
+	dma_addr_t old_dmaaddr;
+	int i, fixed = 0;
+
+	if (!ring || dev->__using_pio_transfers)
+		return;
+
+	for (i = 0; i < ring->nr_slots; i++) {
+		desc = ring->ops->idx2desc(ring, i, &meta);
+		if (!meta->rx_refill_failed)
+			continue;
+
+		old_skb = meta->skb;
+		old_dmaaddr = meta->dmaaddr;
+		if (setup_rx_descbuffer(ring, desc, meta, GFP_KERNEL) == 0) {
+			meta->rx_refill_failed = false;
+			unmap_descbuffer(ring, old_dmaaddr,
+					 ring->rx_buffersize, 0);
+			dev_kfree_skb_any(old_skb);
+			fixed++;
+		} else {
+			sync_descbuffer_for_device(ring, old_dmaaddr,
+						   ring->rx_buffersize);
+		}
+	}
+	if (fixed)
+		b43dbg(dev->wl, "DMA RX: refilled %d slots\n", fixed);
+}
+
 void b43_dma_handle_rx_overflow(struct b43_dmaring *ring)
 {
 	int current_slot, previous_slot;
diff --git a/drivers/net/wireless/broadcom/b43/dma.h b/drivers/net/wireless/broadcom/b43/dma.h
index eddc882..b2fa678 100644
--- a/drivers/net/wireless/broadcom/b43/dma.h
+++ b/drivers/net/wireless/broadcom/b43/dma.h
@@ -192,6 +192,7 @@ struct b43_dmadesc_meta {
 	dma_addr_t dmaaddr;
 	/* ieee80211 TX status. Only used once per 802.11 frag. */
 	bool is_last_fragment;
+	bool rx_refill_failed;
 };
 
 struct b43_dmaring;
@@ -303,6 +304,8 @@ void b43_dma_handle_rx_overflow(struct b43_dmaring *ring);
 
 void b43_dma_rx(struct b43_dmaring *ring);
 
+void b43_dma_rx_retry_poisoned(struct b43_wldev *dev);
+
 void b43_dma_direct_fifo_rx(struct b43_wldev *dev,
 			    unsigned int engine_index, bool enable);
 
diff --git a/drivers/net/wireless/broadcom/b43/main.c b/drivers/net/wireless/broadcom/b43/main.c
index 57a5935..001e272 100644
--- a/drivers/net/wireless/broadcom/b43/main.c
+++ b/drivers/net/wireless/broadcom/b43/main.c
@@ -3389,6 +3389,8 @@ static void b43_periodic_every15sec(struct b43_wldev *dev)
 		}
 	}
 
+	b43_dma_rx_retry_poisoned(dev);
+
 	if (phy->ops->pwork_15sec)
 		phy->ops->pwork_15sec(dev);
 
