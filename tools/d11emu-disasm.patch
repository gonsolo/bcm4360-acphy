+}
+
+///Runs a single command non-interactively and exits (no TTY needed).
+///Currently only "disasm" is supported.
+pub fn run_once(filename : &str, command : &str){
+	let state = State::from_ucode(filename);
+
+	match command {
+		"disasm" => state.print_all_instructions(),
+		_ => println!("Unknown non-interactive command: {}", command),
+	}
 }
